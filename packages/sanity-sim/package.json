{
  "name": "@planetary/sanity-sim",
  "version": "0.1.0",
  "description": "A local Sanity Content Lake simulator. Run `npx @planetary/sanity-sim` in a project: your Studio and app work against local data, with a dashboard at the server root.",
  "license": "MIT",
  "author": "Planetary (https://planetary.co)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planetary/sanity-dataset-simulator.git",
    "directory": "packages/sanity-sim"
  },
  "homepage": "https://github.com/planetary/sanity-dataset-simulator#readme",
  "bugs": {
    "url": "https://github.com/planetary/sanity-dataset-simulator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "sanity-sim": "./bin/sanity-sim.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./register": "./src/register.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dashboard",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "readme": "node scripts/readme.mjs",
    "prepack": "node scripts/readme.mjs"
  },
  "keywords": [
    "sanity",
    "content-lake",
    "emulator",
    "simulator",
    "local-development",
    "groq"
  ],
  "dependencies": {
    "@sanity/mutator": "6.20.0",
    "groq-js": "2.0.0"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@sanity/client": "8.13.0",
    "@sanity/preview-url-secret": "4.1.5"
  }
}
